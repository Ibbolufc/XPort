<?xml version="1.0" encoding="utf-8"?>
<!-- Generated into the build tree by xbox/CMakeLists.txt; edit this template, not the copy. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher must equal the subject of the signing certificate (see xbox/build.ps1). -->
  <Identity Name="XPort" Publisher="@XPORT_PUBLISHER@" Version="@XPORT_APPX_VERSION@" ProcessorArchitecture="x64" />
  <!-- Unused on Xbox, but required by the Visual Studio C++ UWP packaging targets (APPX1673). -->
  <mp:PhoneIdentity PhoneProductId="17c1b401-96a7-4626-b33a-8c3d667be89d" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>XPort</DisplayName>
    <PublisherDisplayName>XPort</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="XPort.App">
      <uap:VisualElements
        DisplayName="XPort"
        Description="PlayStation Remote Play client for Xbox Series X|S"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Outbound internet (PSN, Internet Remote Play in later phases) -->
    <Capability Name="internetClient" />
    <!-- Inbound + outbound internet (holepunch / RUDP in later phases) -->
    <Capability Name="internetClientServer" />
    <!-- LAN: console discovery broadcast, registration, Remote Play session -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
